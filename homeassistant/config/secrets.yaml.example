# Kopieer naar secrets.yaml (wordt niet gecommit).
# Gebruik in configuration.yaml met: !secret naam
#
# voorbeeld_api_key: abc123

# Webhook waarmee de Mac meldt dat de iPhone gebeld wordt (scripts/mac/telefoon-monitor.sh).
# Lang en willekeurig, bijvoorbeeld: telefoon-$(openssl rand -hex 16)
telefoon_webhook_id: telefoon-verander-mij
