# Geheimen
.env
homeassistant/config/secrets.yaml
mosquitto/config/passwd

# Home Assistant runtime-data
homeassistant/config/*
!homeassistant/config/configuration.yaml
!homeassistant/config/automations.yaml
!homeassistant/config/scripts.yaml
!homeassistant/config/scenes.yaml
!homeassistant/config/secrets.yaml.example
!homeassistant/config/dashboards/
!homeassistant/config/packages/
!homeassistant/config/tools/
!homeassistant/config/custom_components/
homeassistant/config/custom_components/*
!homeassistant/config/custom_components/klantkaarten/
!homeassistant/config/custom_components/airco_schema/
!homeassistant/config/www/
homeassistant/config/www/*
!homeassistant/config/www/klantkaart-camera-card.js
!homeassistant/config/www/airco-schema-card.js

# Mosquitto runtime-data
mosquitto/data/*
mosquitto/log/*
!mosquitto/data/.gitkeep
!mosquitto/log/.gitkeep

# Zigbee2MQTT runtime-data (bevat o.a. de netwerksleutel)
zigbee2mqtt/data/*
!zigbee2mqtt/data/.gitkeep

# Eufy-brug (sessie en apparaatsleutels)
eufy/data/*
!eufy/data/.gitkeep

# ESPHome build-bestanden en geheimen
esphome/config/.esphome/
esphome/config/secrets.yaml

# OS
.DS_Store

# Python
__pycache__/
matter/data/*
!matter/data/.gitkeep
