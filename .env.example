# Kopieer naar .env (of draai ./scripts/setup.sh) en vul in.
# .env staat in .gitignore en wordt nooit gecommit.

TZ=Europe/Amsterdam

# Inloggegevens voor de MQTT-broker (Mosquitto).
# Gebruikt door Zigbee2MQTT en door de MQTT-integratie in Home Assistant.
MQTT_USER=homeassistant
MQTT_PASSWORD=verander-mij

# Zigbee-stick (alleen nodig met --profile zigbee).
# Vind het pad met: ls -l /dev/serial/by-id/
ZIGBEE_DEVICE=/dev/serial/by-id/usb-JOUW_STICK_HIER
# zstack = SONOFF ZBDongle-P / CC2652, ember = SONOFF ZBDongle-E / EFR32
ZIGBEE_ADAPTER=zstack

# Eufy (alleen nodig met --profile eufy).
# Gebruik een APART Eufy-account waarmee je de deurbel deelt (Eufy-app > Instellingen > Delen),
# anders log je jezelf steeds uit in de app.
EUFY_USERNAME=
EUFY_PASSWORD=
EUFY_COUNTRY=NL
